    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet positive = 0, negative = 0, neutral = 0;\n\nfor (const item of items) {\n  const s = item.json.Sentiment;\n  if (s === 'Positive') positive++;\n  else if (s === 'Negative') negative++;\n  else if (s === 'Neutral') neutral++;\n}\n\nconst total = items.length;\nconst pctPositive = total ? ((positive / total) * 100).toFixed(1) : 0;\nconst pctNegative = total ? ((negative / total) * 100).toFixed(1) : 0;\nconst pctNeutral = total ? ((neutral / total) * 100).toFixed(1) : 0;\n\nreturn [{\n  json: {\n    total_tweets: total,\n    sentimen_positif: positive,\n    sentimen_negatif: negative,\n    sentimen_netral: neutral,\n    persentase_positif: pctPositive,\n    persentase_negatif: pctNegative,\n    persentase_netral: pctNeutral\n  }\n}];"
      },
