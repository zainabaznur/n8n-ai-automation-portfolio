      "parameters": {
        "jsCode": "const inputData = $input.all();\nconst allRows = inputData.flatMap(item =>\n  Array.isArray(item.json) ? item.json : [item.json]\n);\nconst result = allRows.map(row => ({\n  ...row,\n  'Sumber': 'Sheet3'\n}));\nreturn result.map(row => ({ json: row }));"
      },
