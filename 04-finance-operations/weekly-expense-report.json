    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nconst now = new Date();\nconst sevenDaysAgo = new Date();\nsevenDaysAgo.setDate(now.getDate() - 7);\n\n// Kumpulkan semua baris valid terlebih dahulu\nconst allRows = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const rawDate = row['Tanggal'];\n  if (!rawDate) continue;\n  \n  let tgl;\n  if (String(rawDate).includes('/')) {\n    const parts = String(rawDate).split('/');\n    tgl = new Date(parts[2], parts[1] - 1, parts[0]);\n  } else {\n    tgl = new Date(rawDate);\n  }\n  \n  if (isNaN(tgl.getTime())) continue;\n  \n  allRows.push({ row, tgl });\n  \n  // Filter utama: 7 hari terakhir\n  if (tgl >= sevenDaysAgo && tgl <= now) {\n    results.push(row);\n  }\n}\n\n// Fallback: jika tidak ada data dalam 7 hari terakhir,\n// gunakan semua data agar jalur AI tetap bisa diuji\nconst finalResults = results.length > 0 ? results : allRows.map(r => r.row);\nconst isFallback = results.length === 0 && finalResults.length > 0;\n\nlet formattedText = '';\nfor (const row of finalResults) {\n  formattedText += `- Tanggal: ${row['Tanggal']}, Kategori: ${row['Kategori']}, Deskripsi: ${row['Deskripsi']}, Jumlah: Rp${row['Jumlah (IDR)']}\\n`;\n}\n\nreturn [{\n  json: {\n    hasExpenses: finalResults.length > 0,\n    totalItems: finalResults.length,\n    isFallback: isFallback,\n    formattedText: formattedText || 'Tidak ada transaksi.'\n  }\n}];"
      },
