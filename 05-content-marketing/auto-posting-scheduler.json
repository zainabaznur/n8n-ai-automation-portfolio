          "id": "p1Z251sLffVAS9TJ",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst filteredItems = [];\n\nconst now = new Date();\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // 1. Cek Status\n  const status = String(data.Status || '').trim();\n  if (status !== 'Pending') continue;\n  \n  // 2. Cek Kelengkapan\n  const dateStr = String(data['Scheduled Date'] || '').trim();\n  const timeStr = String(data['Scheduled Time'] || '').trim();\n  if (!dateStr || !timeStr) continue;\n  \n  try {\n    // 3. Parsing tanggal — FORMAT DD/MM/YYYY\n    const dateParts = dateStr.split('/');\n    const day = parseInt(dateParts[0], 10);    // 11 (hari)\n    const month = parseInt(dateParts[1], 10);  // 02 (bulan)\n    const year = parseInt(dateParts[2], 10);   // 2026\n    \n    // 4. Parsing waktu\n    const timeParts = timeStr.split(':');\n    const hour = parseInt(timeParts[0], 10);\n    const minute = parseInt(timeParts[1], 10);\n    const second = parseInt(timeParts[2] || 0, 10);\n    \n    // 5. Buat Date object\n    const scheduledDate = new Date(year, month - 1, day, hour, minute, second);\n    \n    // 6. Bandingkan\n    if (scheduledDate <= now) {\n      filteredItems.push(item);\n    }\n  } catch (error) {\n    continue;\n  }\n}\n\nreturn filteredItems;"
      },
