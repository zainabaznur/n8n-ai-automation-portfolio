    {
      "parameters": {
        "jsCode": "// Ambil semua item dari node sebelumnya\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  // Ambil resultJson (bisa berupa string atau object)\n  let resultJson = item.json.data?.resultJson;\n  \n  // Jika masih string, parse dulu\n  if (typeof resultJson === 'string') {\n    try {\n      resultJson = JSON.parse(resultJson);\n    } catch (e) {\n      continue; // skip jika parsing gagal\n    }\n  }\n  \n  // Ekstrak array resultUrls\n  const urls = resultJson?.resultUrls || [];\n  \n  // Filter URL yang valid\n  const validUrls = urls.filter(url => url && url.trim() !== '');\n  \n  // Buat output untuk setiap URL\n  for (let i = 0; i < validUrls.length; i++) {\n    results.push({\n      json: {\n        url: validUrls[i],\n        index: i\n      }\n    });\n  }\n}\n\nreturn results;"
      },
