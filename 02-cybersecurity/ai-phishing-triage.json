    {
      "parameters": {
        "promptType": "define",
        "text": "=Anda adalah analis keamanan siber. Analisis teks email berikut untuk tanda-tanda phishing, berfokus pada urgensi palsu, tautan mencurigakan, permintaan info pribadi, atau peniruan identitas bank.\n\nBerikan skor bahaya dari 1 sampai 10.\nJawab dengan format: Skor: [angka] | Email: [pengirim] | Subjek: [subjek]\n\nEmail:\nFrom: {{ $('Gmail Trigger').item.json.From }}\nSubject: {{ $('Gmail Trigger').item.json.Subject }}\nBody: {{ $('Gmail Trigger').item.json.snippet }}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        480,
        224
      ],
      "name": "Analisa Phishing",
      "id": "5c2f1090-88bf-4227-b8d1-03b7c1d0f618"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const text = item.json.text || item.json.output || item.json.response || '';\n  const match = String(text).match(/Skor:\\s*(\\d+)/i);\n  const skor = match ? parseInt(match[1]) : 0;\n  \n  results.push({\n    json: {\n      ...item.json,\n      skor_bahaya: skor\n    }\n  });\n}\n\nreturn results;"
      },
